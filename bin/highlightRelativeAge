#!/bin/bash

: ${HIGHLIGHTRELATIVEAGE_RESET='[0m'}
typeset -a defaultColors=(
'[38;5;192m'
'[38;5;155m'
'[38;5;149m'
"$HIGHLIGHTRELATIVEAGE_RESET"
'[38;5;132m'
'[38;5;124m'
'[38;5;161m'
'[38;5;197m'
)
typeset -a dashboardColors=(
'[38;2;215;255;135m'
'[38;2;255;255;255m'
'[38;2;238;238;238m'
"$HIGHLIGHTRELATIVEAGE_RESET"
'[38;2;72;72;72m'
'[38;2;175;21;26m'
'[38;2;143;52;52m'
'[38;2;127;86;86m'
)
: ${HIGHLIGHTRELATIVEAGE_COLORS:="${defaultColors[*]}"}

printUsage()
{
    cat <<HELPTEXT
Highlight relative dates with colors, depending on the age.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-d|--delete-date] [-p|--palette dashboard] [-e SED-EXPR ...] [--] [FILE ...] [-?|-h|--help]'
    echo
    printf 'Usage: cat FILE [...] | %q %s\n' "$(basename "$1")" '[...]'
}
match=
frontReplacement='\3'
prefixReplacement='\1\2'
innerReplacement='\3'
typeset -a sedArgs=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	    shift; printUsage "$0"; exit 0;;
	--delete-date|-d)   shift; match='\(.*\)'; frontReplacement='\7'; prefixReplacement=''; innerReplacement='\2\6';;
	--palette|-p)	    shift
			    case "$1" in
				dashboard)  HIGHLIGHTRELATIVEAGE_COLORS="${dashboardColors[*]}";;
				*)	    printf 'ERROR: Invalid palette: %s\n' "$1"
					    echo
					    printUsage "$0"
					    exit 2
					    ;;
			    esac >&2
			    shift
			    ;;
	--)		    break;;
	*)		    sedArgs+=("$1"); shift;;
    esac
done

typeset -a COLOR=()
IFS='' read -r -a COLOR <<<"${HIGHLIGHTRELATIVEAGE_COLORS// /}"

typeset -a ageConverterPattern=()
addPattern()
{
    ageConverterPattern+=(
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ seconds\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[0]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ minutes\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[1]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ hours\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[2]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[1-9][0-9]\\+ days ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[4]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[1-9] days\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[3]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ weeks\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[5]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ months\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[6]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ years\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[7]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
    )
}

colorPattern='\(\x1b\[[0-9:;]*m\)\?'
# [LINE-COLOR] PREFIX (AGE) [SUFFIX]
lineColorPattern="^${colorPattern}"
beforePattern='\(.*\)'
prefixPattern='\([[:space:]]\+(\)'
suffixPattern='\()\)'
addPattern

# [LINE-COLOR] AGE [SUFFIX]
lineColorPattern="^${colorPattern}"
beforePattern='\(\)'
prefixPattern='\(\)'
suffixPattern="\\(${colorPattern}\$\|[[:space:]]\\+\\)"
prefixReplacement=''
innerReplacement="$frontReplacement"
addPattern

exec sed "${sedArgs[@]}" "${ageConverterPattern[@]}" "$@"
