#!/bin/bash

: ${HIGHLIGHTRELATIVEAGE_RESET='[0m'}
typeset -a defaultColors=(
'[38;5;192m'
'[38;5;155m'
'[38;5;149m'
"$HIGHLIGHTRELATIVEAGE_RESET"
'[38;5;124m'
'[38;5;161m'
'[38;5;197m'
)
typeset -a dashboardColors=(
'[38;2;215;255;135m'
'[38;2;255;255;255m'
'[38;2;238;238;238m'
"$HIGHLIGHTRELATIVEAGE_RESET"
'[38;2;175;21;26m'
'[38;2;143;52;52m'
'[38;2;127;86;86m'
)
typeset -a testingColors=(
'{SECONDS}'
'{MINUTES}'
'{HOURS}'
'{1-9DAYS_OR_WEEK}'
'{10+DAYS_OR_WEEKS}'
'{MONTHS}'
'{YEARS}'
)
testingReset='{}'

: ${HIGHLIGHTRELATIVEAGE_COLORS:="${defaultColors[*]}"}

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-d|--delete-date] [-p|--palette dashboard] [-e SED-EXPR ...] [--] [FILE ...] [-?|-h|--help]'
    printf 'Usage: cat FILE [...] | %q %s\n' "$(basename "$1")" '[...]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Highlight relative dates with colors, depending on the age.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
DEMO:
HELPTEXT
    export HIGHLIGHTRELATIVEAGE_COLORS HIGHLIGHTRELATIVEAGE_RESET
    "${BASH_SOURCE[0]}" <<'EOF'
20 seconds ago
2 minutes ago
3 hours ago
4 days ago is close to
1 week ago
11 days ago is almost as long as
2 weeks ago
3 months ago is old
4 years ago is very far away now
EOF
}

match=
frontReplacement='\3'
prefixReplacement='\1\2'
innerReplacement='\3'
typeset -a sedArgs=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	    shift; printLongUsage "$0"; exit 0;;
	--delete-date|-d)   shift; match='\(.*\)'; frontReplacement='\7'; prefixReplacement=''; innerReplacement='\2\6';;
	--palette|-p)	    shift
			    eval "HIGHLIGHTRELATIVEAGE_COLORS=\"\${${1:?}Colors[*]}\""
			    if [ -z "$HIGHLIGHTRELATIVEAGE_COLORS" ]; then
				printf 'ERROR: Invalid palette: %s\n' "$1"
				echo
				printUsage "$0"
				exit 2
			    fi >&2
			    eval "resetOverride=\"\${${1:?}Reset}\""
			    [ -n "$resetOverride" ] && HIGHLIGHTRELATIVEAGE_RESET="$resetOverride"
			    shift
			    ;;
	--)		    break;;
	*)		    sedArgs+=("$1"); shift;;
    esac
done

typeset -a COLOR=()
IFS='' read -r -a COLOR <<<"${HIGHLIGHTRELATIVEAGE_COLORS// /}"

typeset -a ageConverterPattern=()
addPattern()
{
    ageConverterPattern+=(
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ seconds\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[0]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ minutes\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[1]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ hours\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[2]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[1-9][0-9]\\+ days ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[4]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[1-9] days\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[3]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}1 week ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[3]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ weeks\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[4]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ months\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[5]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
	    -e "s/${lineColorPattern}${beforePattern}\\(${prefixPattern}[0-9]\\+ years\\? ago${suffixPattern}\\)${match}/${prefixReplacement}${COLOR[6]}${innerReplacement}${HIGHLIGHTRELATIVEAGE_RESET}\\1/; t" \
    )
}

colorPattern='\(\x1b\[[0-9:;]*m\)\?'
# [LINE-COLOR] PREFIX (AGE) [SUFFIX]
lineColorPattern="^${colorPattern}"
beforePattern='\(.*\)'
prefixPattern='\([[:space:]]\+(\)'
suffixPattern='\()\)'
addPattern

# [LINE-COLOR] AGE [SUFFIX]
lineColorPattern="^${colorPattern}"
beforePattern='\(\)'
prefixPattern='\(\)'
suffixPattern="\\(${colorPattern}\$\|[[:space:]]\\+\\)"
prefixReplacement=''
innerReplacement="$frontReplacement"
addPattern

exec sed "${sedArgs[@]}" "${ageConverterPattern[@]}" "$@"
