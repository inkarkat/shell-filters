#!/usr/bin/awk -f

BEGIN {
    if (ARGV[1] ~ /^(--(help|man|usage)|-[Hh?])$/) {
	print "Make lines unique by appending a (1), (2), ... count to them if necessary."
	print ""
	print "Usage: makeLinesUnique FILE [...] [-?|-H|--man|--usage]"
	print "Usage: cat FILE [...] | makeLinesUnique]"
	exit
    }
}
function appendNumber(line, number)
{
    return line " (" number ")"
}
{
    lines[NR] = $0
    a[$0] += 1
    a[appendNumber($0, a[$0])] += 1
}
END {
    for (i = 1; i <= NR; i++) {
	iline = lines[i]
	if (a[iline] > 1) {
	    while (a[iline] > 1) {
		iline = appendNumber(iline, ++c[iline])
	    }
	    a[iline] += 1
	}
	print iline
    }
}
